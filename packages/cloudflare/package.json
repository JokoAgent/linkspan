{
  "name": "@jokoagent/linkspan-cloudflare",
  "version": "0.1.0",
  "type": "module",
  "description": "Explicitly prepared, integrity-pinned Cloudflare Tunnel connector for Linkspan hosts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./turn": { "types": "./dist/turn.d.ts", "import": "./dist/turn.js" }
  },
  "files": ["dist", "README.md", "LICENSE.cloudflared", "UPSTREAM.md", "THIRD_PARTY_NOTICES.cloudflared.md", "cloudflared.build-inputs.json", "cloudflared-restricted.patch", "scripts/build-restricted-helper.mjs", "scripts/restricted-http2-test.go", "scripts/restricted-origin-test.go", "scripts/restricted-tls-test.go"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=24.16.0" },
  "dependencies": { "@jokoagent/linkspan-core": "workspace:*", "tar": "7.5.22" }
}
